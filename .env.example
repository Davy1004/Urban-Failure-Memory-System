# Copy to .env and fill in. Never commit .env.
APP_NAME="Urban Failure Memory System"
ENVIRONMENT=development
DEBUG=true

# Local dev (docker-compose maps MySQL to host port 3307 to avoid clashing
# with a native MySQL on 3306). For Aiven, paste their connection string.
DATABASE_URL=mysql+pymysql://ufms:ufms@127.0.0.1:3307/ufms

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-before-you-deploy-anything
ACCESS_TOKEN_EXPIRE_MINUTES=60

CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Open-Meteo needs no key. Left here so the ingestion config has one home.
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
