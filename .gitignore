# Secrets
.env
.env.local

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Data. Downloads are large and re-fetchable; derived panels are rebuildable.
# Note the glob form: "data/raw/" would ignore the directory itself, and git
# cannot un-ignore a file inside an ignored directory, so .gitkeep would vanish
# and a fresh clone would have no data/raw/ for the loaders to write into.
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep
# ...with one exception. data/raw/ is ignored because it is large and
# re-fetchable, but that means a fresh clone cannot run the `derive` step and so
# cannot produce a working dashboard. demo_data.sql is the 612 KB of derived
# rows the five endpoints actually read, so clone + alembic + restore gives a
# demo with no 200 MB of downloads. Regenerate with
# scripts/export_demo_dump.py; it holds no credentials (users is excluded).
!data/processed/demo_data.sql

# Trained model artifacts
models/*.joblib
models/*.pkl

# OS / editor
.DS_Store
Thumbs.db

# Frontend (frontend/ is an npm project inside this repository, not a sibling).
# Anchored with a leading slash so these never match a Python directory that
# happens to share the name.
/frontend/node_modules/
/frontend/dist/
/frontend/.vite/
/frontend/coverage/
/frontend/screenshots/
*.local
